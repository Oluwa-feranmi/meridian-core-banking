# Copy to .env.test. Used ONLY by `npm run test:integration` and `npm run
# test:api` (unit tests need no database at all — see docs/04-testing-guide.md).
#
# DB_NAME must contain "test" — tests/setup/testDb.ts refuses to run
# otherwise, as a safety net against accidentally truncating a real
# database.

NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian_test
DB_USER=meridian_app
DB_PASSWORD=change_me_locally
DB_SSL=false

JWT_SECRET=test_only_secret_do_not_use_elsewhere_______
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
