# -----------------------------------------------------------------------------
# Meridian Core Banking API — environment configuration
#
# Copy this file to `.env` for local development. In AWS, these same keys
# are provided as SSM Parameter Store SecureStrings injected into the ECS
# task definition — never committed, never baked into the Docker image.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (matches docker-compose.yml service `db` for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian
DB_USER=meridian_app
DB_PASSWORD=change_me_locally
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

# Auth
JWT_SECRET=replace_with_a_long_random_value_in_every_environment
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# CORS — the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
