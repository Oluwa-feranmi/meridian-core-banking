{
  "family": "meridian-migrate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::224039895487:role/meridian_ecs_task_execution_role",
  "taskRoleArn": "arn:aws:iam::224039895487:role/meridian_ecs_task_role",
  "containerDefinitions": [
    {
      "name": "meridian-migrate",
      "image": "224039895487.dkr.ecr.eu-west-1.amazonaws.com/meridian-backend:latest",
      "essential": true,
      "workingDirectory": "/app",
      "command": [
        "sh",
        "-c",
        "npm ci && npm run migrate && npm run seed"
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DB_HOST",
          "value": "meridian-db.cfceqoo4g8f8.eu-west-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "meridian"
        },
        {
          "name": "DB_USER",
          "value": "meridian"
        },
        {
          "name": "DB_SSL",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-west-1:224039895487:secret:meridian/db-password:password::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-1:224039895487:secret:meridian/jwt-secret:secret::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/meridian-migrate",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
