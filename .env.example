# -----------------------------------------------------------------------------
# Variables consumed by docker-compose.yml itself (docker compose
# automatically reads a `.env` file in the same directory as the compose
# file). Copy this to `.env` at the project root before running
# `docker compose up`.
#
# These are DIFFERENT from backend/.env and frontend/.env, which are only
# used if you run the services outside Docker (see docs/03-local-dev.md).
# -----------------------------------------------------------------------------

DB_PASSWORD=change_me_locally
JWT_SECRET=replace_with_a_long_random_value_before_running_anything_real
